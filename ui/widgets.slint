import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: Theme.shadow-y;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> marked;
    in property <color> swatch;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent : (area.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.accent : Theme.line;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        spacing: Theme.s8;
        alignment: center;
        cross-axis-alignment: center;
        if root.marked: Rectangle {
            width: Theme.s8;
            height: Theme.s8;
            border-radius: Theme.s4;
            background: root.swatch;
        }
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            color: root.selected ? Theme.on-accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1 : 0.45;
    background: !root.enabled ? Theme.surface-2 : (area.pressed ? Theme.accent-pressed : (area.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: Theme.motion; }
    animate opacity { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s16;
        padding-right: Theme.s16;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            font-weight: 600;
            color: root.enabled ? Theme.on-accent : Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> enabled: true;
    out property <bool> has-hover: area.has-hover;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.s32;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? transparent : (area.pressed ? Theme.line : (area.has-hover ? Theme.surface-2 : transparent));
    animate background { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s8;
        padding-right: Theme.s8;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-xs;
            color: root.danger ? Theme.danger : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SummaryCard inherits Card {
    in property <string> caption;
    in property <string> value;
    horizontal-stretch: 1;
    min-width: 0px;
    height: Theme.card-h;

    VerticalLayout {
        padding: Theme.s16;
        spacing: Theme.s8;
        alignment: start;
        Text {
            text: root.caption;
            font-size: Theme.font-xs;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: root.value;
            font-size: Theme.font-xl;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
    }
}

export component TextField inherits VerticalLayout {
    in property <string> caption;
    in property <string> placeholder;
    in property <string> error;
    in-out property <string> value;
    callback accepted();
    callback edited();
    spacing: Theme.s4;

    Text {
        text: root.caption;
        font-size: Theme.font-xs;
        color: Theme.muted;
    }

    edit := LineEdit {
        placeholder-text: root.placeholder;
        text <=> root.value;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    if root.error != "": Text {
        text: root.error;
        font-size: Theme.font-xs;
        color: Theme.danger;
        wrap: word-wrap;
    }

    public function focus-input() {
        edit.focus();
    }
}

export component SubscriptionRowView inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> when;
    in property <string> price;
    in property <string> letter;
    in property <color> swatch;
    in property <bool> paused;
    in property <bool> confirming;
    in property <string> pause-label;
    in property <string> balance-text;
    in property <bool> can-topup;
    callback edit();
    callback topup();
    callback pause();
    callback ask();
    callback remove();
    callback cancel();
    background: root.hot ? Theme.surface-2 : transparent;
    animate background { duration: Theme.motion; }

    property <bool> hot: area.has-hover || edit-b.has-hover || pause-b.has-hover || delete-b.has-hover || topup-b.has-hover;
    height: root.balance-text == "" ? Theme.row : Theme.row + Theme.s16;

    area := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s8;
        spacing: Theme.s12;
        cross-axis-alignment: center;

        Rectangle {
            width: Theme.s32;
            height: Theme.s32;
            border-radius: Theme.radius-sm;
            background: root.swatch;
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.letter;
                    color: Theme.on-accent;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s4;
            alignment: center;
            Text {
                text: root.name;
                font-size: Theme.font-md;
                font-weight: 600;
                color: root.paused ? Theme.muted : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.detail;
                font-size: Theme.font-xs;
                color: Theme.muted;
                overflow: elide;
            }
            if root.balance-text != "": Text {
                text: root.balance-text;
                font-size: Theme.font-xs;
                font-weight: 600;
                color: Theme.accent;
                overflow: elide;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            spacing: Theme.s4;
            alignment: center;
            Text {
                text: root.when;
                font-size: Theme.font-xs;
                color: Theme.muted;
                horizontal-alignment: right;
            }
            Text {
                text: root.price;
                font-size: Theme.font-md;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: Theme.s4;
            alignment: end;
            cross-axis-alignment: center;
            opacity: root.hot || root.confirming ? 1 : 0;
            animate opacity { duration: Theme.motion; }

            topup-b := GhostButton {
                label: "Пополнить";
                visible: root.can-topup;
                enabled: root.can-topup && !root.confirming;
                clicked => { if (root.can-topup && !root.confirming) { root.topup(); } }
            }
            edit-b := GhostButton {
                label: "Изменить";
                enabled: !root.confirming;
                clicked => { if (!root.confirming) { root.edit(); } }
            }
            pause-b := GhostButton {
                label: root.confirming ? "Отмена" : root.pause-label;
                clicked => {
                    if (root.confirming) { root.cancel(); }
                    else { root.pause(); }
                }
            }
            delete-b := GhostButton {
                label: root.confirming ? "Да" : "Удалить";
                danger: true;
                clicked => {
                    if (root.confirming) { root.remove(); }
                    else { root.ask(); }
                }
            }
        }
    }
}
