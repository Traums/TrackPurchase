import { LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component TrashGlyph inherits Rectangle {
    width: 16px;
    height: 16px;
    in property <color> ink: Theme.danger;

    Rectangle {
        x: 4px;
        y: 0px;
        width: 8px;
        height: 2px;
        border-radius: 1px;
        background: root.ink;
    }
    Rectangle {
        y: 3px;
        width: 16px;
        height: 1.5px;
        border-radius: 1px;
        background: root.ink;
    }
    Rectangle {
        x: 2px;
        y: 6px;
        width: 12px;
        height: 9px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.ink;
    }
    Rectangle {
        x: 6px;
        y: 8px;
        width: 1.5px;
        height: 5px;
        background: root.ink;
    }
    Rectangle {
        x: 9px;
        y: 8px;
        width: 1.5px;
        height: 5px;
        background: root.ink;
    }
}

export component SearchGlyph inherits Rectangle {
    width: 14px;
    height: 14px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: 9px;
        height: 9px;
        border-radius: 5px;
        border-width: 1.5px;
        border-color: Theme.muted;
    }
    Rectangle {
        x: 7px;
        y: 8px;
        width: 6px;
        height: 1.5px;
        border-radius: 1px;
        background: Theme.muted;
        transform-rotation: -40deg;
    }
}

export component GearGlyph inherits Rectangle {
    width: 14px;
    height: 14px;
    Rectangle {
        width: 14px;
        height: 2px;
        y: 6px;
        border-radius: 1px;
        background: Theme.text;
    }
    Rectangle {
        width: 2px;
        height: 14px;
        x: 6px;
        border-radius: 1px;
        background: Theme.text;
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 1.5px;
        border-color: Theme.text;
        background: Theme.surface;
    }
    Rectangle {
        x: 4px;
        y: 4px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.text;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    horizontal-stretch: 0;
    width: Theme.search;
    height: Theme.control;
    border-radius: Theme.radius;
    background: Theme.surface-2;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }

    if root.text == "": Text {
        x: 34px;
        height: parent.height;
        text: "Поиск";
        font-size: Theme.font-sm;
        color: Theme.muted;
        vertical-alignment: center;
    }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        spacing: Theme.s8;
        cross-axis-alignment: center;
        SearchGlyph { }
        input := TextInput {
            text <=> root.text;
            font-size: Theme.font-sm;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    public function focus-input() {
        input.focus();
    }
}

export component SettingsButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    background: area.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: Theme.hairline;
    border-color: Theme.line;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        spacing: Theme.s8;
        alignment: center;
        cross-axis-alignment: center;
        GearGlyph { }
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: Theme.shadow-y;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 1;
    border-radius: Theme.radius-sm;
    background: root.on ? Theme.accent : transparent;
    animate background { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            font-weight: root.on ? 600 : 400;
            color: root.on ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component StatusSwitch inherits Rectangle {
    in property <int> current;
    callback selected(int);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    background: Theme.surface-2;
    border-width: Theme.hairline;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        Segment { label: "Активные"; on: root.current == 1; clicked => { root.selected(1); } }
        Segment { label: "Все"; on: root.current == 0; clicked => { root.selected(0); } }
        Segment { label: "Пауза"; on: root.current == 2; clicked => { root.selected(2); } }
    }
}

export component PeriodCard inherits Card {
    in property <string> value;
    in property <int> index;
    callback changed(int);
    horizontal-stretch: 1;
    min-width: 0px;
    height: Theme.card-h;

    property <string> caption: root.index == 0 ? "За 7 дней" : (root.index == 2 ? "За 360 дней" : "За 30 дней");

    VerticalLayout {
        padding-left: Theme.s16;
        padding-right: Theme.s16;
        padding-top: Theme.s12;
        padding-bottom: Theme.s8;
        spacing: Theme.s4;
        alignment: start;
        Text {
            text: root.caption;
            font-size: Theme.font-xs;
            color: Theme.muted;
        }
        Text {
            text: root.value;
            font-size: Theme.font-xl;
            font-weight: 600;
            font-family: "Segoe UI";
            color: Theme.text;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 4px;
            Segment { label: "7 дней"; on: root.index == 0; clicked => { root.changed(0); } }
            Segment { label: "30 дней"; on: root.index == 1; clicked => { root.changed(1); } }
            Segment { label: "360 дней"; on: root.index == 2; clicked => { root.changed(2); } }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> marked;
    in property <color> swatch;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent : (area.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.accent : Theme.line;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        spacing: Theme.s8;
        alignment: center;
        cross-axis-alignment: center;
        if root.marked: Rectangle {
            width: Theme.s8;
            height: Theme.s8;
            border-radius: Theme.s4;
            background: root.swatch;
        }
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            color: root.selected ? Theme.on-accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.control;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1 : 0.45;
    background: !root.enabled ? Theme.surface-2 : (area.pressed ? Theme.accent-pressed : (area.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: Theme.motion; }
    animate opacity { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s16;
        padding-right: Theme.s16;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-sm;
            font-weight: 600;
            color: root.enabled ? Theme.on-accent : Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-hover: area.has-hover;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.s32;
    border-radius: Theme.radius-sm;
    background: area.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: Theme.hairline;
    border-color: area.has-hover ? Theme.muted : Theme.line;
    animate background { duration: Theme.motion; }
    animate border-color { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s12;
        padding-right: Theme.s12;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-xs;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> enabled: true;
    out property <bool> has-hover: area.has-hover;
    callback clicked();
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.s32;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? transparent : (area.pressed ? Theme.line : (area.has-hover ? Theme.surface-2 : transparent));
    animate background { duration: Theme.motion; }

    HorizontalLayout {
        padding-left: Theme.s8;
        padding-right: Theme.s8;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.font-xs;
            color: root.danger ? Theme.danger : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SummaryCard inherits Card {
    in property <string> caption;
    in property <string> value;
    in property <bool> featured;
    background: root.featured ? (Theme.dark ? #203c3b : #e0f5ee) : Theme.surface;
    border-color: root.featured ? (Theme.dark ? #376359 : #a8d9ca) : Theme.line;
    horizontal-stretch: 1;
    min-width: 0px;
    height: Theme.card-h;

    VerticalLayout {
        padding: Theme.s16;
        spacing: Theme.s8;
        alignment: start;
        Text {
            text: root.caption;
            font-size: Theme.font-xs;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: root.value;
            font-size: Theme.font-xl;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
    }
}

export component TextField inherits VerticalLayout {
    in property <string> caption;
    in property <string> placeholder;
    in property <string> error;
    in-out property <string> value;
    callback accepted();
    callback edited();
    spacing: Theme.s4;

    Text {
        text: root.caption;
        font-size: Theme.font-xs;
        color: Theme.muted;
    }

    edit := LineEdit {
        placeholder-text: root.placeholder;
        text <=> root.value;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    if root.error != "": Text {
        text: root.error;
        font-size: Theme.font-xs;
        color: Theme.danger;
        wrap: word-wrap;
    }

    public function focus-input() {
        edit.focus();
    }
}

export component SubscriptionRowView inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> when;
    in property <string> date;
    in property <string> price;
    in property <string> letter;
    in property <color> swatch;
    in property <color> category-swatch;
    in property <bool> paused;
    in property <string> balance-text;
    in property <bool> balance-short;
    in property <string> badge;
    callback edit();
    callback pause();
    callback topup();
    in property <bool> can-topup;
    callback remove();
    background: root.hot ? Theme.surface-2 : transparent;
    animate background { duration: Theme.motion; }

    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
    property <bool> hot: area.has-hover || action.has-hover || delete-hit.has-hover;
    property <length> date-col: 120px;
    property <length> price-col: 96px;
    horizontal-stretch: 1;
    height: root.balance-text == "" ? Theme.row : Theme.row + Theme.s16;

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.edit(); }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.s12;
        padding-right: 48px;
        spacing: Theme.s12;
        cross-axis-alignment: center;

        Rectangle {
            width: Theme.s32;
            height: Theme.s32;
            border-radius: 16px;
            background: root.swatch;
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.letter;
                    color: Theme.on-accent;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: parent.width - 10px;
                y: parent.height - 10px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.category-swatch;
                border-width: 1px;
                border-color: Theme.page;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s4;
            alignment: center;
            Text {
                text: root.name;
                font-size: Theme.font-md;
                font-weight: 600;
                color: root.paused ? Theme.muted : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.detail;
                font-size: Theme.font-xs;
                color: Theme.muted;
                overflow: elide;
            }
            if root.balance-text != "": Text {
                text: root.badge != "" ? root.balance-text + " · " + root.badge : root.balance-text;
                font-size: Theme.font-xs;
                font-weight: 600;
                color: root.paused ? Theme.muted : (root.balance-short ? Theme.danger : Theme.ok);
                overflow: elide;
            }
        }

        action := SecondaryButton {
            opacity: root.hot ? 1 : 0;
            enabled: root.hot;
            animate opacity { duration: Theme.motion; }
            label: root.can-topup ? "Пополнить" : (root.paused ? "Включить" : "Пауза");
            clicked => { if root.can-topup { root.topup(); } else { root.pause(); } }
        }

        VerticalLayout {
            width: root.date-col;
            horizontal-stretch: 0;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.when;
                font-size: Theme.font-sm;
                font-weight: 600;
                color: root.paused ? Theme.muted : Theme.text;
                horizontal-alignment: right;
                overflow: elide;
            }
            Text {
                text: root.date;
                font-size: Theme.font-xs;
                color: Theme.muted;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        Text {
            width: root.price-col;
            horizontal-stretch: 0;
            text: root.price;
            font-size: Theme.font-md;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Rectangle {
        x: parent.width - 44px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: Theme.radius-sm;
        opacity: root.hot ? 1 : 0;
        background: delete-hit.has-hover ? Theme.danger-soft : transparent;
        animate opacity { duration: Theme.motion; }
        animate background { duration: Theme.motion; }
        TrashGlyph {
            x: 8px;
            y: 8px;
        }
        delete-hit := TouchArea {
            enabled: root.hot;
            mouse-cursor: pointer;
            clicked => { root.remove(); }
        }
    }
}
