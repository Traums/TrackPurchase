import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: true;
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    out property <color> page: dark ? #10151e : #f3f5f8;
    out property <color> surface: dark ? #19212e : #ffffff;
    out property <color> surface-2: dark ? #232e3e : #eaf0f5;
    out property <color> text: dark ? #f3f5f8 : #1c1c1e;
    out property <color> muted: dark ? #a3b0c2 : #6e6e73;
    out property <color> line: dark ? #ffffff14 : #dce3eb;
    out property <color> accent: #319f88;
    out property <color> accent-hover: #3cb69c;
    out property <color> accent-pressed: #25836f;
    out property <color> on-accent: #ffffff;
    out property <color> danger: #ff5d63;
    out property <color> ok: #3ecf8e;
    out property <color> ok-soft: #3ecf8e22;
    out property <color> danger-soft: #ff5d6322;
    out property <color> overlay: #000000a6;
    out property <color> shadow: dark ? #00000059 : #00000014;

    out property <length> s4: 4px;
    out property <length> s8: 8px;
    out property <length> s12: 12px;
    out property <length> s16: 16px;
    out property <length> s24: 24px;
    out property <length> s32: 32px;

    out property <length> radius: 14px;
    out property <length> radius-sm: 8px;
    out property <length> hairline: 1px;
    out property <length> control: 38px;
    out property <length> row: 72px;
    out property <length> card-h: 116px;
    out property <length> dialog: 480px;
    out property <length> side: 300px;
    out property <length> search: 220px;
    out property <length> list-min: 180px;
    out property <length> shadow-blur: 0px;
    out property <length> shadow-y: 10px;

    out property <length> font-xs: 12px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 15px;
    out property <length> font-lg: 20px;
    out property <length> font-xl: 28px;

    out property <length> window-w: 1240px;
    out property <length> window-h: 880px;
    out property <length> window-min-w: 900px;
    out property <length> window-min-h: 600px;
    out property <length> wide-at: 880px;

    out property <duration> motion: 160ms;
}
